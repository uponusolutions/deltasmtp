{
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          // Nested modules (benchmark/compare) run from their own directory,
          // so resolve go.tool.mod from the repository root.
          "sh",
          "-c",
          "exec go tool -modfile=\"$(git rev-parse --show-toplevel)/go.tool.mod\" golangci-lint \"$@\"",
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path="
        ]
      }
    }
  },
  "languages": {
    "Go": {
      "tab_size": 8,
      "language_servers": ["gopls", "golangci-lint"]
    }
  }
}
